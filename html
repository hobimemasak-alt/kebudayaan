
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">

    <!-- Membuat tampilan responsif di perangkat mobile -->
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Deskripsi halaman untuk mesin pencari -->
    <meta name="description" content="Jelajahi pesona kebudayaan Indonesia, dari Wayang Kulit hingga Rumah Gadang.">

    <title>Pesona Kebudayaan Indonesia</title>

    <!-- Menghubungkan file CSS eksternal -->
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- Header dan navigasi utama -->
    <header class="site-header">
        <nav class="navbar container" aria-label="Navigasi utama">
            <a href="#beranda" class="logo">
                Pesona<span>Nusantara</span>
            </a>

            <ul class="nav-links">
                <li><a href="#beranda">Beranda</a></li>
                <li><a href="#budaya">Kebudayaan</a></li>
                <li><a href="#tentang">Tentang</a></li>
            </ul>
        </nav>
    </header>

    <main>
        <!-- Hero section: bagian pembuka halaman -->
        <section class="hero" id="beranda">
            <div class="hero-content container">
                <p class="eyebrow">WARISAN INDAH NUSANTARA</p>

                <h1>
                    Pesona
                    <span>Kebudayaan Indonesia</span>
                </h1>

                <p class="hero-description">
                    Menyelami kekayaan tradisi, seni, dan warisan leluhur
                    yang menjadikan Indonesia begitu istimewa.
                    Berbeda budaya, tetap satu dalam harmoni.
                </p>

                <!-- Tombol CTA menuju galeri -->
                <a href="#budaya" class="btn btn-primary">
                    Jelajahi Kebudayaan
                    <span aria-hidden="true">→</span>
                </a>

                <p class="hero-note">
                    BHINNEKA TUNGGAL IKA — BERBEDA-BEDA TETAP SATU
                </p>
            </div>
        </section>

        <!-- Galeri budaya Indonesia -->
        <section class="culture-section section-padding" id="budaya">
            <div class="container">
                <div class="section-heading">
                    <p class="eyebrow">KEKAYAAN NUSANTARA</p>

                    <h2>Warisan Budaya yang Memikat</h2>

                    <p>
                        Setiap daerah menyimpan cerita dan keindahan
                        yang patut kita kenali serta lestarikan.
                    </p>
                </div>

                <!-- Grid kartu kebudayaan -->
                <div class="culture-grid">

                    <!-- Kartu 1: Wayang Kulit -->
                    <article class="culture-card">
                        <div class="card-image">
                            <img
                                src="https://images.unsplash.com/photo-1518709268805-4e9042af9f23?auto=format&fit=crop&w=900&q=85"
                                alt="Ilustrasi bernuansa seni tradisional untuk budaya Wayang Kulit"
                                loading="lazy"
                            >
                            <span class="card-number">01</span>
                        </div>

                        <div class="card-content">
                            <p class="card-category">JAWA</p>
                            <h3>Wayang Kulit</h3>

                            <p>
                                Seni pertunjukan tradisional yang memadukan
                                kisah kehidupan, filosofi, musik gamelan,
                                dan keterampilan seorang dalang.
                            </p>

                            <a
                                href="https://id.wikipedia.org/wiki/Wayang_kulit"
                                class="card-link"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Kenali lebih jauh <span aria-hidden="true">↗</span>
                            </a>
                        </div>
                    </article>

                    <!-- Kartu 2: Tari Pendet -->
                    <article class="culture-card">
                        <div class="card-image">
                            <img
                                src="https://images.unsplash.com/photo-1577717903315-1691ae25ab3f?auto=format&fit=crop&w=900&q=85"
                                alt="Suasana budaya dan tradisi Bali"
                                loading="lazy"
                            >
                            <span class="card-number">02</span>
                        </div>

                        <div class="card-content">
                            <p class="card-category">BALI</p>
                            <h3>Tari Pendet</h3>

                            <p>
                                Tarian tradisional Bali yang anggun,
                                dikenal melalui gerak yang ekspresif
                                serta makna penyambutan dan penghormatan.
                            </p>

                            <a
                                href="https://id.wikipedia.org/wiki/Tari_Pendet"
                                class="card-link"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Kenali lebih jauh <span aria-hidden="true">↗</span>
                            </a>
                        </div>
                    </article>

                    <!-- Kartu 3: Rumah Gadang -->
                    <article class="culture-card">
                        <div class="card-image">
                            <img
                                src="https://images.unsplash.com/photo-1596402184320-417e7178b2cd?auto=format&fit=crop&w=900&q=85"
                                alt="Arsitektur tradisional sebagai inspirasi rumah adat Nusantara"
                                loading="lazy"
                            >
                            <span class="card-number">03</span>
                        </div>

                        <div class="card-content">
                            <p class="card-category">SUMATRA BARAT</p>
                            <h3>Rumah Gadang</h3>

                            <p>
                                Rumah adat Minangkabau dengan atap
                                melengkung yang khas, mencerminkan
                                identitas, kebersamaan, dan adat setempat.
                            </p>

                            <a
                                href="https://id.wikipedia.org/wiki/Rumah_Gadang"
                                class="card-link"
                                target="_blank"
                                rel="noopener noreferrer"
                            >
                                Kenali lebih jauh <span aria-hidden="true">↗</span>
                            </a>
                        </div>
                    </article>

                </div>
            </div>
        </section>

        <!-- Ajakan untuk melestarikan kebudayaan -->
        <section class="preserve-section" id="tentang">
            <div class="container preserve-content">
                <p class="eyebrow">JAGA WARISAN KITA</p>

                <h2>Budaya adalah Identitas Bangsa</h2>

                <p>
                    Mari mengenal, menghargai, dan mewariskan kekayaan
                    budaya Indonesia kepada generasi berikutnya.
                </p>

                <a
                    href="https://ich.unesco.org/"
                    class="btn btn-outline"
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Pelajari Warisan Budaya
                    <span aria-hidden="true">↗</span>
                </a>
            </div>
        </section>
    </main>

    <!-- Footer halaman -->
    <footer class="site-footer">
        <div class="container footer-content">
            <a href="#beranda" class="logo footer-logo">
                Pesona<span>Nusantara</span>
            </a>

            <p>
                © 2026 Pesona Kebudayaan Indonesia.
                Bangga akan warisan Nusantara.
            </p>
        </div>
    </footer>

</body>
</html>
